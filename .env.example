# --- Public site settings (safe to expose in the browser) ---
# Your real domain, once you have one (no trailing slash). Needed for correct SEO links, sitemap and sharing.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
NEXT_PUBLIC_BUSINESS_NAME=Dr. Mohammad Zubair
# Include country code
NEXT_PUBLIC_PHONE_NUMBER=+919456938356
NEXT_PUBLIC_WHATSAPP_NUMBER=+919456938356
NEXT_PUBLIC_CONTACT_EMAIL=mozubair1989@gmail.com
# Google Analytics 4 Measurement ID, looks like G-XXXXXXXXXX (see README, section "Google Analytics")
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console "HTML tag" verification code (the content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Server-only secrets: where booking-form requests are delivered (set at least ONE option) ---
# Option A (easiest, free): Google Apps Script web-app URL from docs/google-apps-script.gs
APPOINTMENT_WEBHOOK_URL=
# Option B: email through Resend (https://resend.com)
RESEND_API_KEY=
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_TO_EMAIL=mozubair1989@gmail.com
